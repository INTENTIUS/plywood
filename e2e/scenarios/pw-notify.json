{
  "$schema": "https://intentius.io/chant/schemas/e2e-harness/e2e-scenario/v1/e2e-scenario.schema.json",
  "contract": 1,
  "id": "pw-notify",
  "product": "plywood",
  "claim": "notify/signed-webhook",
  "title": "A drift run sends one chant.notify/v1 event signed under the key the receiver holds (Forgejo only; the receiver is the bench's)",
  "tree": {
    "base": "base",
    "overlays": "overlays"
  },
  "reportUrl": "s3://plywood-tutorial-reports/shop",
  "steps": [
    {
      "id": "receiver",
      "do": "out-of-band",
      "label": "a receiver starts on the bench's network",
      "command": [
        "plywood-e2e",
        "receiver"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "notify-on",
      "do": "out-of-band",
      "label": "main schedules prod-us's drift check and names the webhook's variables",
      "command": [
        "plywood-e2e",
        "configure",
        "notify-drift"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "events",
      "do": "open",
      "branch": "e2e/notify-events",
      "overlay": "prod-us-events-7200",
      "title": "prod-us: keep events for two hours"
    },
    {
      "id": "events-plan",
      "do": "plan",
      "pull": "events",
      "expect": [
        {
          "report": {
            "status": "planned"
          }
        }
      ]
    },
    {
      "id": "events-approve",
      "do": "approve",
      "pull": "events"
    },
    {
      "id": "events-merge",
      "do": "merge",
      "pull": "events"
    },
    {
      "id": "update",
      "do": "out-of-band",
      "label": "the merge's wave job settled prod-us",
      "command": [
        "plywood-e2e",
        "wait-stacks",
        "pulumi-up",
        "prod-us"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "applied",
      "do": "out-of-band",
      "label": "the update applied prod-us, which stores the export the drift read compares against",
      "command": [
        "plywood-e2e",
        "applied",
        "pulumi-up",
        "prod-us"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "by-hand",
      "do": "out-of-band",
      "label": "the events queue's retention is changed on floci behind Pulumi's back",
      "command": [
        "plywood-e2e",
        "sqs-retention",
        "prod-us",
        "60"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "drift-job",
      "do": "out-of-band",
      "label": "the drift job, with the webhook's URL and signing key, exits with chant's drift code",
      "command": [
        "plywood-e2e",
        "notify-drift-job",
        "prod-us",
        "${PLYWOOD_E2E_SIGNING_KEY:-plywood-e2e-hook-key}"
      ],
      "expect": [
        {
          "exit": 2
        }
      ]
    },
    {
      "id": "signed",
      "do": "out-of-band",
      "label": "the receiver holds a drift event from plywood naming the stack, verifying under its key",
      "command": [
        "plywood-e2e",
        "received",
        "signed",
        "drift",
        "plywood",
        "shop/prod-us",
        "plywood-e2e-hook-key"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    }
  ],
  "break": {
    "env": {
      "BREAK": "1",
      "PLYWOOD_E2E_SIGNING_KEY": "another-key"
    },
    "note": "The job signs with a key the receiver does not hold, so the delivery arrives and its signature does not verify: the signed step must fail. This runs on Forgejo only: the bench has no GitHub or GitLab, and those forges' comment and status paths are not exercised."
  }
}
