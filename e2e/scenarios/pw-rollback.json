{
  "$schema": "https://intentius.io/chant/schemas/e2e-harness/e2e-scenario/v1/e2e-scenario.schema.json",
  "contract": 1,
  "id": "pw-rollback",
  "product": "plywood",
  "claim": "rollback/gated-release",
  "title": "An environment rolls back to the release it ran before, through its release gate (Forgejo only)",
  "tree": {
    "base": "base",
    "overlays": "overlays"
  },
  "reportUrl": "s3://plywood-tutorial-reports/shop",
  "steps": [
    {
      "id": "promotion",
      "do": "out-of-band",
      "label": "main sets promotion, and plywood init writes the component with each environment's stack",
      "command": [
        "plywood-e2e",
        "configure",
        "promotion"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "release-a",
      "do": "out-of-band",
      "label": "release shop-a is cut from main's tip, tagged green",
      "command": [
        "plywood-e2e",
        "release",
        "shop-a"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "deploy-a",
      "do": "out-of-band",
      "label": "prod-us runs release shop-a, its release gate approved by the reviewer",
      "command": [
        "plywood-e2e",
        "deploy-gated",
        "prod-us",
        "shop-a"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "events",
      "do": "out-of-band",
      "label": "main keeps prod-us events for two hours",
      "command": [
        "plywood-e2e",
        "configure",
        "promotion-prod-us-events-7200"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "release-b",
      "do": "out-of-band",
      "label": "release shop-b is cut from that commit",
      "command": [
        "plywood-e2e",
        "release",
        "shop-b"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "deploy-b",
      "do": "out-of-band",
      "label": "prod-us runs release shop-b",
      "command": [
        "plywood-e2e",
        "deploy-gated",
        "prod-us",
        "shop-b"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "revoke",
      "do": "out-of-band",
      "label": "the commit of ${PLYWOOD_E2E_REVOKED:-none} is revoked (none in the plain arm)",
      "command": [
        "plywood-e2e",
        "revoke",
        "${PLYWOOD_E2E_REVOKED:-none}"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "applied",
      "do": "out-of-band",
      "label": "plywood rollback prod-us to shop-a waits at the release gate, the reviewer approves it, and the restore is recorded",
      "command": [
        "plywood-e2e",
        "rollback",
        "prod-us",
        "shop-a"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    }
  ],
  "break": {
    "env": {
      "BREAK": "1",
      "PLYWOOD_E2E_REVOKED": "shop-a"
    },
    "note": "the commit shop-a was cut from is revoked, so chant refuses the rollback with release-revoked before any gate, nothing is restored, and the applied step must fail. This runs on Forgejo only: the bench has no GitHub or GitLab, and those forges' status paths are not exercised."
  }
}
