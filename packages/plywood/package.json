{
  "name": "@intentius/plywood",
  "version": "0.3.2",
  "description": "Pulumi ops and governance.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTENTIUS/plywood.git",
    "directory": "packages/plywood"
  },
  "homepage": "https://intentius.io/plywood/",
  "bin": {
    "plywood": "dist/plywood.mjs"
  },
  "files": [
    "dist",
    "plywood.schema.json",
    "templates",
    "presets",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-cli.mjs",
    "schema": "node scripts/build-schema.mjs",
    "images": "node scripts/build-images.mjs",
    "bundle-check": "node scripts/build-schema.mjs --check && node scripts/build-images.mjs --check && chant dev bundle-check .",
    "prepack": "node scripts/build-cli.mjs"
  },
  "chantBundleCheck": {
    "bundle": "dist/plywood.mjs",
    "maxPackBytes": 2097152,
    "needs": [
      "@intentius/chant",
      "@intentius/chant-lexicon-pulumi",
      "@intentius/chant-lexicon-forgejo",
      "@intentius/chant-lexicon-github",
      "@intentius/chant-lexicon-gitlab"
    ],
    "metafile": "../../node_modules/.cache/plywood/metafile.json"
  },
  "dependencies": {
    "@intentius/chant": "0.124.88",
    "@intentius/chant-lexicon-forgejo": "0.124.88",
    "@intentius/chant-lexicon-github": "0.124.88",
    "@intentius/chant-lexicon-gitlab": "0.124.88",
    "@intentius/chant-lexicon-pulumi": "0.124.88"
  }
}
