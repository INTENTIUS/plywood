            "token_secret": {
              "type": "string",
              "description": "The secret holding the dispatch token. Default CHANT_CONTROL_TOKEN."
            },
            "read_token_secret": {
              "type": "string",
              "description": "The secret holding a read-only token for the control repo. Default CHANT_CONTROL_READ_TOKEN."
            },
            "ref": {
              "type": "string",
              "description": "The branch a GitLab or Forgejo dispatch runs on. Default main."
            },
            "api_base": {
              "type": "string",
              "description": "The forge's REST base, when the host's usual one is not it."
            }
          }
        }
      ]
