            "member": {
              "type": "string",
              "description": "This repository's name in the control repo's workspace. Default the repository's name."
            },
            "forge": {
              "type": "string",
              "enum": [
                "github",
                "gitlab",
                "forgejo"
              ],
              "description": "The control repo's forge, when its host does not say."
