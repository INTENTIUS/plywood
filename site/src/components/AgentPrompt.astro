---
// "Optional: hand this page to your coding agent": a closed card under the
// page's content. Opened, it shows the prompt, a button that copies it and one
// that copies a link to it. The card is a shortcut, never a requirement. The
// text is the page's `prompt:` front matter, or `text` when given. The footer
// (Footer.astro) renders it on every page with a `prompt:`, so a page needs no
// import for it; a page that places <AgentPrompt /> itself gets it there instead. Every prompt ends with
// neverLine from src/prompts.ts, which forbids apply, approval and merge.
// Adapted from plunge's site.
import { promptText } from '../prompts';
import Saw from "./Saw.astro";

interface Props {
	label?: string;
	note?: string;
	text?: string;
}
const {
	label = 'Optional: hand this page to your coding agent',
	note = 'The steps work by hand too.',
	text,
} = Astro.props;
const prompt = text ?? promptText(Astro.locals.starlightRoute?.entry.data.prompt);
---
{prompt && (
	<figure class="pw-prompt not-content" id="agent-prompt">
		<details>
			<summary>
				<span class="label"><Saw size={16} />{label}</span>
				<span class="note">{note}</span>
			</summary>
			<pre class="full"><code>{prompt}</code></pre>
			<div class="actions">
				<button type="button" class="copy" data-copy={prompt} data-done="Copied">Copy prompt</button>
				<button type="button" class="link" data-link data-done="Link copied">Copy link</button>
			</div>
		</details>
	</figure>
)}

<script>
	const flash = (button: HTMLButtonElement, text: string) => {
		const was = button.textContent;
		button.textContent = text;
		setTimeout(() => (button.textContent = was), 1600);
	};
	for (const button of document.querySelectorAll<HTMLButtonElement>('.pw-prompt button')) {
		button.addEventListener('click', async () => {
			const card = button.closest('figure')!;
			const text = button.dataset.link !== undefined ? `${location.origin}${location.pathname}#${card.id}` : (button.dataset.copy ?? '');
			try {
				await navigator.clipboard.writeText(text);
				flash(button, button.dataset.done ?? 'Copied');
			} catch {
				// No clipboard (an insecure origin, a denied permission): open the
				// prompt and select it so the reader can copy it by hand.
				card.querySelector('details')?.setAttribute('open', '');
				const code = card.querySelector('.full code');
				if (code) window.getSelection()?.selectAllChildren(code);
				flash(button, 'Selected');
			}
		});
	}
</script>

<style>
	.pw-prompt {
		margin: 2.5rem 0 0;
		width: min(100%, 44rem);
		text-align: left;
		border: 1px solid var(--pw-rule);
		border-left: 2px solid var(--pw-grain);
		border-radius: 0.6rem;
		background: var(--pw-panel);
		overflow: hidden;
	}
	summary {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		padding: 0.7rem 1rem;
		cursor: pointer;
	}
	.label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.note {
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
	}
	pre {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		background: none;
		border: 0;
		padding: 0;
	}
	.full {
		padding: 0.25rem 1rem 0;
	}
	.actions {
		display: flex;
		gap: 0.5rem;
		padding: 0.7rem 1rem 0.8rem;
	}
	button {
		font: inherit;
		font-size: 0.78rem;
		font-weight: 600;
		border-radius: 0.45rem;
		padding: 0.35rem 0.85rem;
		cursor: pointer;
	}
	.copy {
		color: var(--sl-color-black);
		background: var(--pw-accent);
		border: 1px solid var(--pw-accent);
	}
	.copy:hover {
		filter: brightness(1.1);
	}
	.link {
		color: var(--sl-color-white);
		background: none;
		border: 1px solid var(--pw-rule);
	}
	.link:hover {
		border-color: var(--pw-grain);
	}
</style>
