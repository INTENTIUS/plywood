---
// The home page under the hero: the door picker. The text above it is ProductHome's.
import Picker from './Picker.astro';
---
<div class="pw-landing not-content">
	<Picker />
</div>

<style>
	.pw-landing {
		display: grid;
		gap: 2rem;
		max-width: 64rem;
		margin: 0 auto;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		overflow-wrap: anywhere;
	}
	.pw-landing :global(.pw-picker) {
		margin: 0;
	}
</style>
