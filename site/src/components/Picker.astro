---
// The home page's door picker, in plunge's picker shape: your backend and your
// repo shape as two rows of tiles, the roles as a line of links at the end. A
// card gives the first step for that pick and the two rooms to read. Every list
// comes from data/rooms.ts, the room pages' source. The first pick is rendered
// on the server, so the card reads the same without script. A production build
// shows only rooms whose page it publishes, and no picker when it has none.
import Bench from './Bench.astro';
import { BACKENDS, ROLES, SHAPES, room } from '../data/rooms';
import { href, live } from '../lib/links';

const roomHref = (id: string) => `/for/${id}/`;
const backends = BACKENDS.filter((b) => live(roomHref(b.room)));
const shapes = SHAPES.filter((s) => live(roomHref(s.room)));
const roles = ROLES.filter((r) => live(roomHref(r.room)));
const tiles = backends.map((b) => ({ id: b.id, room: href(roomHref(b.room)), title: room(b.room).title, first: live(b.first.href) ? { label: b.first.label, href: href(b.first.href) } : { label: room(b.room).title, href: href(roomHref(b.room)) } }));
const shapeTiles = shapes.map((s) => ({ id: s.id, room: href(roomHref(s.room)), title: room(s.room).title }));
const data = { tiles, shapes: shapeTiles };
const [tile] = tiles;
const [shape] = shapeTiles;
const show = tiles.length > 0 && shapeTiles.length > 0;
---
{show && (
	<section class="pw-picker not-content" aria-label="Where to start">
		<div class="tiles" role="group" aria-labelledby="pw-pick-backend">
			<span id="pw-pick-backend" class="h">Your backend</span>
			{backends.map((b, i) => (
				<button type="button" class="tile" data-pick="tile" value={b.id} aria-pressed={String(i === 0)}>
					<Bench size={32} />
					<b>{b.label}</b>
					<small>{b.blurb}</small>
				</button>
			))}
		</div>
		<div class="tiles" role="group" aria-labelledby="pw-pick-shape">
			<span id="pw-pick-shape" class="h">Your repo shape</span>
			{shapes.map((s, i) => (
				<button type="button" class="tile" data-pick="shape" value={s.id} aria-pressed={String(i === 0)}>
					<Bench size={32} />
					<b>{s.label}</b>
					<small>{s.blurb}</small>
				</button>
			))}
		</div>
		<div class="card" aria-live="polite">
			<a class="go" data-first href={tile.first.href}>{tile.first.label}</a>
			<p class="sub" data-more>Then read <a href={tile.room}>{tile.title}</a> and <a href={shape.room}>{shape.title}</a>.</p>
		</div>
		{roles.length > 0 && (
			<nav class="roles" aria-label="By role">
				<span>Or start from your role</span>
				{roles.map((r) => <a class="role" href={href(roomHref(r.room))}><Bench size={16} />{r.label}</a>)}
			</nav>
		)}
		<script type="application/json" data-picker-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
	</section>
)}

<script>
	type Data = {
		tiles: { id: string; room: string; title: string; first: { label: string; href: string } }[];
		shapes: { id: string; room: string; title: string }[];
	};
	const key = 'pw-picker';
	for (const section of document.querySelectorAll<HTMLElement>('.pw-picker')) {
		const data = JSON.parse(section.querySelector('[data-picker-data]')!.textContent!) as Data;
		const pick: Record<string, string> = { tile: data.tiles[0].id, shape: data.shapes[0].id };
		try {
			const saved = JSON.parse(localStorage.getItem(key) ?? '{}') as Record<string, string>;
			for (const k of Object.keys(pick)) if (saved[k]) pick[k] = saved[k];
		} catch {}
		const $ = <T extends Element = HTMLElement>(sel: string) => section.querySelector<T>(sel)!;
		const link = (label: string, href: string) => Object.assign(document.createElement('a'), { href, textContent: label });
		const show = () => {
			const tile = data.tiles.find((t) => t.id === pick.tile) ?? data.tiles[0];
			const shape = data.shapes.find((s) => s.id === pick.shape) ?? data.shapes[0];
			for (const b of section.querySelectorAll<HTMLButtonElement>('button[data-pick]')) {
				b.setAttribute('aria-pressed', String(pick[b.dataset.pick!] === b.value));
			}
			const go = $<HTMLAnchorElement>('[data-first]');
			go.href = tile.first.href;
			go.textContent = tile.first.label;
			$('[data-more]').replaceChildren('Then read ', link(tile.title, tile.room), ' and ', link(shape.title, shape.room), '.');
			try {
				localStorage.setItem(key, JSON.stringify(pick));
			} catch {}
		};
		section.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-pick]');
			if (!b) return;
			pick[b.dataset.pick!] = b.value;
			show();
		});
		show();
	}
</script>

<style>
	.pw-picker {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.1rem;
		width: 100%;
		min-width: 0;
		max-width: 64rem;
		margin: 0 auto 3rem;
		font-size: var(--sl-text-sm);
		overflow-wrap: anywhere;
	}
	.tiles {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.tile {
		position: relative;
		min-width: 0;
		display: grid;
		gap: 0.35rem;
		align-content: start;
		padding: 0.75rem;
		text-align: left;
		font: inherit;
		color: var(--sl-color-white);
		background: var(--pw-panel);
		border: 1px solid var(--pw-rule);
		border-top: 2px solid var(--pw-rule);
		border-radius: 0.6rem;
		cursor: pointer;
	}
	.tile :global(img) {
		opacity: 0.4;
	}
	.tile b {
		line-height: 1.3;
	}
	.tile small {
		font-size: var(--sl-text-xs);
		line-height: 1.35;
		color: var(--sl-color-gray-3);
	}
	.status {
		justify-self: start;
		margin-top: 0.15rem;
		padding: 0.05rem 0.45rem;
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--sl-color-white);
		border: 1px solid var(--pw-accent);
		border-radius: 999px;
	}
	.status.none {
		border-color: var(--pw-rule);
		color: var(--sl-color-gray-3);
	}
	.tile:hover {
		border-color: var(--pw-grain);
	}
	.tile[aria-pressed='true'] {
		border-top-color: var(--pw-accent);
		box-shadow: inset 0 0 0 1px var(--pw-accent);
	}
	.tile[aria-pressed='true'] :global(img) {
		opacity: 1;
	}
	.tiles > .h {
		grid-column: 1 / -1;
		margin: 0;
	}
	.roles > span,
	.h {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}
	.roles > span {
		margin-right: 0.25rem;
	}
	.role {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.8rem 0.4rem 0.5rem;
		font-weight: 500;
		color: var(--sl-color-white);
		background: var(--pw-panel);
		border: 1px solid var(--pw-rule);
		border-radius: 0.5rem;
		text-decoration: none;
	}
	.role:hover,
	.role:focus-visible {
		border-color: var(--pw-grain);
	}
	.card {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		align-items: center;
		padding: 1rem;
		background: var(--pw-panel);
		border: 1px solid var(--pw-rule);
		border-top: 1px solid var(--pw-grain);
		border-radius: 0.6rem;
	}
	.card :global(a) {
		color: var(--pw-accent);
	}
	.go {
		display: inline-block;
		padding: 0.55rem 1rem;
		font-weight: 600;
		color: var(--sl-color-black) !important;
		background: var(--pw-accent);
		border-radius: 0.5rem;
		text-decoration: none;
	}
	.go:hover {
		filter: brightness(1.1);
	}
	.sub {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.notes {
		display: grid;
		gap: 0.35rem;
		padding: 0 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.notes .h {
		margin: 0;
	}
	.notes ul {
		display: grid;
		gap: 0.3rem;
		margin: 0;
		padding-left: 1.1rem;
	}
	.notes ul:empty {
		display: none;
	}
	.notes :global(li) {
		margin: 0;
	}
	@media (max-width: 52rem) {
		.tiles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
