---
// One room, from data/rooms.ts, in fixed sections: who it is for, features,
// the features every setup gets, differences, first step, then the pages to
// read in order: how-to, explanation, reference.
import { ASSUMED, room } from '../data/rooms';
import { href, live } from '../lib/links';

interface Props {
	id: string;
}
const r = room(Astro.props.id);
---
<div class="pw-room not-content">
	<section id="who">
		<h2>Who it is for</h2>
		<p class="lede">{r.lede}</p>
	</section>
	<div class="cols">
		<section id="works">
			<h2>Features</h2>
			<ul>{r.works.map((w) => <li>{w}</li>)}</ul>
		</section>
		<section id="count">
			<h2>Every setup gets</h2>
			<ul>{ASSUMED.map((a) => <li>{live(a.href) ? <a href={href(a.href)}>{a.label}</a> : a.label}</li>)}</ul>
		</section>
		{r.differs.length > 0 && (
			<section id="differs">
				<h2>Differences</h2>
				<ul>{r.differs.map((d) => <li>{d}</li>)}</ul>
			</section>
		)}
		<section id="first" class="first">
			<h2>First step</h2>
			<p>{live(r.first.href) ? <a href={href(r.first.href)}>{r.first.label}</a> : r.first.label}</p>
		</section>
	</div>
	<section id="read" class="read">
		<h2>Then read</h2>
		<dl>
			<dt>How-to</dt>
			<dd>{r.howto.filter((l) => live(l.href)).map((l) => <a href={href(l.href)}>{l.label}</a>)}</dd>
			<dt>Explanation</dt>
			<dd>{r.explain.filter((l) => live(l.href)).map((l) => <a href={href(l.href)}>{l.label}</a>)}</dd>
			<dt>Reference</dt>
			<dd>{r.reference.filter((l) => live(l.href)).map((l) => <a href={href(l.href)}>{l.label}</a>)}</dd>
		</dl>
	</section>
</div>
<style>
	.pw-room {
		display: grid;
		gap: 2rem;
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
	.lede {
		font-size: var(--sl-text-base);
		color: var(--sl-color-gray-1);
	}
	.cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 0.75rem;
	}
	.cols section {
		padding: 1rem 1.15rem;
		border: 1px solid var(--pw-rule);
		border-top: 1px solid var(--pw-grain);
		border-radius: 0.6rem;
		background: var(--pw-panel);
	}
	h2 {
		margin: 0 0 0.6rem;
		font-size: 0.68rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--sl-color-gray-3);
	}
	ul {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		position: relative;
		margin: 0;
		padding-left: 1.6rem;
	}
	li::before {
		content: '';
		position: absolute;
		left: 0;
		top: calc((1lh - 7px) / 2);
		width: 12px;
		height: 7px;
		background: var(--pw-saw-bullet) center / 12px 7px no-repeat;
	}
	p {
		margin: 0;
	}
	a {
		color: var(--pw-accent);
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
		text-decoration-color: var(--pw-grain);
		text-underline-offset: 0.2em;
	}
	.first a {
		display: inline-block;
		padding: 0.45rem 0.9rem;
		font-weight: 600;
		color: var(--sl-color-black);
		background: var(--pw-accent);
		border-radius: 0.5rem;
	}
	.first a:hover {
		text-decoration: none;
		filter: brightness(1.1);
	}
	dl {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 0.75rem 1.25rem;
		margin: 0;
	}
	dt {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		padding-top: 0.3rem;
	}
	dd {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
	}
	dd a {
		padding: 0.2rem 0.6rem;
		color: var(--sl-color-white);
		border: 1px solid var(--pw-rule);
		border-radius: 999px;
	}
	dd a:hover {
		text-decoration: none;
		border-color: var(--pw-grain);
	}
	@media (max-width: 40rem) {
		dl {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
		dd {
			margin-bottom: 0.6rem;
		}
	}
</style>
