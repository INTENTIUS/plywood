---
// A "With plunge" aside: one feature plunge adds to the pipeline, credited in
// fixed words. The wording lives
// here so every page credits plunge the same way.
interface Props {
	/** The feature, as a clause after "the pipeline also gets". */
	feature: string;
}
const { feature } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<aside class="pw-with-plunge not-content" aria-label="With plunge">
	<p>
		<b>With <a href={`${base}/concepts/glossary/#plunge`}>plunge</a></b>, the Pulumi fork from the team behind plywood, the pipeline also gets {feature}.
	</p>
</aside>

<style>
	.pw-with-plunge {
		margin: 1.25rem 0;
		padding: 0.75rem 1rem;
		background: var(--pw-panel);
		border: 1px solid var(--pw-rule);
		border-left: 3px solid var(--pw-grain);
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.pw-with-plunge p {
		margin: 0;
	}
	.pw-with-plunge b {
		color: var(--sl-color-white);
	}
	.pw-with-plunge a {
		color: var(--pw-accent);
	}
</style>
