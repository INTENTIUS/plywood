{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "ci/**/*.ts",
    "publish/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "e2e/**/*.ts",
    "chant.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["packages/*/test/fixtures/**"]
}
